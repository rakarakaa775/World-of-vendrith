# Vendrith Creator AI
# Keep the real credential in .env.local or Vercel Environment Variables.
# Local development: set AI_GATEWAY_API_KEY, or pull Vercel OIDC with `vercel env pull .env.local`.
AI_GATEWAY_API_KEY=
# Optional: Vercel OIDC token for local development when using Vercel OIDC.
VERCEL_OIDC_TOKEN=
VENDRITH_AI_MODEL=openai/gpt-5
# Optional override for a compatible OpenAI Chat Completions gateway.
VENDRITH_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Optional repository override
VENDRITH_GITHUB_OWNER=rakarakaa775
VENDRITH_GITHUB_REPOSITORY=World-of-vendrith
VENDRITH_GITHUB_REF=feat/vendrith-ecc-v1
GITHUB_TOKEN=
